set_pin_assignment { clk_50m } { LOCATION = R7; IOSTANDARD = LVCMOS33; }
set_pin_assignment { rst_n } { LOCATION = E3; IOSTANDARD = LVCMOS33; }
set_pin_assignment { led } { LOCATION = B14; IOSTANDARD = LVCMOS33; }
set_pin_assignment { hdmi_clk_p } { LOCATION = P1; IOSTANDARD = LVDS33; }
set_pin_assignment { hdmi_data_p[0] } { LOCATION = N1; IOSTANDARD = LVDS33; }
set_pin_assignment { hdmi_data_p[1] } { LOCATION = P4; IOSTANDARD = LVDS33; }
set_pin_assignment { hdmi_data_p[2] } { LOCATION = J3; IOSTANDARD = LVDS33; }
# From supplied M0_Borad 6_SD_Card_SPI - V2/sd_card.adc.
set_pin_assignment { sd_sck } { LOCATION = F15; IOSTANDARD = LVCMOS33; }
set_pin_assignment { sd_cs } { LOCATION = F13; IOSTANDARD = LVCMOS33; }
set_pin_assignment { sd_miso } { LOCATION = D14; IOSTANDARD = LVCMOS33; }
set_pin_assignment { sd_mosi } { LOCATION = F14; IOSTANDARD = LVCMOS33; }


# 4x4 keyboard: drive one row low, sample columns after settling.
set_pin_assignment { key_col[3] } { LOCATION = F10; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_col[2] } { LOCATION = C11; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_col[1] } { LOCATION = D11; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_col[0] } { LOCATION = E11; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_row[0] } { LOCATION = E10; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_row[1] } { LOCATION = C10; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_row[2] } { LOCATION = F9; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_row[3] } { LOCATION = D9; IOSTANDARD = LVCMOS33; }
